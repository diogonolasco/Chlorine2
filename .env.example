# ==========================================
# Configuração do Chlorine Music™
# ==========================================
DISCORD_TOKEN=seu_token_do_discord_aqui
SUPPORT_SERVER_URL=https://discord.gg/6MFj275a3S

# Porta HTTP do painel web (Na ShardCloud com Publicação na Web use 80, no Windows use 3000)
PORT=3000

# URL pública do painel (ex: https://meuapp.shardweb.app na ShardCloud ou http://localhost:3000 local)
DASHBOARD_URL=http://localhost:3000

# ==========================================
# Login com Discord (OAuth2) & Painel Web
# Obtenha em: https://discord.com/developers/applications -> Sua Aplicação -> OAuth2 -> General
# ==========================================
DISCORD_CLIENT_ID=seu_client_id_aqui
DISCORD_CLIENT_SECRET=seu_client_secret_aqui
SESSION_SECRET=uma_chave_secreta_longa_e_aleatoria_para_proteger_sessoes

# ==========================================
# Credenciais da API do Spotify (Opcional - Spotify Developer Dashboard)
# ==========================================
SPOTIFY_CLIENT_ID=seu_client_id_do_spotify_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_do_spotify_aqui
SPOTIFY_COUNTRY=BR
